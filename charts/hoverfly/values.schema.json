{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hoverfly chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
        "claims": { "type": "array", "items": { "type": "object" } }
      }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "probe": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    },
    "containerList": { "type": "array", "items": { "type": "object" } }
  },
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "Never", "IfNotPresent"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },

    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "commonAnnotations": { "$ref": "#/definitions/stringMap" },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "type": "string" }
      }
    },

    "hoverfly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "proxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "listenOnHost": { "type": "string" },
        "webserver": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["simulate", "capture", "spy", "diff", "synthesize", "modify"] },
        "captureOnMiss": { "type": "boolean" },
        "logLevel": { "type": "string", "enum": ["panic", "fatal", "error", "warn", "info", "debug"] },
        "logsFormat": { "type": "string", "enum": ["plaintext", "json"] },
        "journalSize": { "type": "integer", "minimum": 0 },
        "cacheSize": { "type": "integer", "minimum": 0 },
        "disableCache": { "type": "boolean" },
        "tlsVerification": { "type": "boolean" },
        "cors": { "type": "boolean" },
        "upstreamProxy": { "type": "string" },
        "middleware": { "type": "string" },
        "destination": { "type": "string" },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },

    "simulations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline": { "$ref": "#/definitions/stringMap" },
        "existingConfigMap": { "type": "string" },
        "existingConfigMapFiles": { "type": "array", "items": { "type": "string" } },
        "extraImports": { "type": "array", "items": { "type": "string" } },
        "mountPath": { "type": "string", "pattern": "^/.*" }
      }
    },

    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "size": { "$ref": "#/definitions/quantity" },
        "mountPath": { "type": "string", "pattern": "^/.+" },
        "filename": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "retain": { "type": "boolean" }
      }
    },

    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "nativeSidecar": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": { "type": "string" },
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "Never", "IfNotPresent"] }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": { "type": "object" }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "proxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminNodePort": { "type": ["integer", "string"] },
        "proxyNodePort": { "type": ["integer", "string"] },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "clusterIP": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "sessionAffinity": { "type": "string", "enum": ["None", "ClientIP"] }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
                    "servicePortName": { "type": "string", "enum": ["admin", "proxy"] }
                  },
                  "required": ["path"]
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "startupProbe": { "$ref": "#/definitions/probe" },

    "resources": { "$ref": "#/definitions/resources" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },

    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "schedulerName": { "type": "string" },
    "dnsPolicy": { "type": "string", "enum": ["", "ClusterFirst", "ClusterFirstWithHostNet", "Default", "None"] },
    "dnsConfig": { "type": "object" },
    "hostAliases": { "type": "array", "items": { "type": "object" } },

    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      }
    },

    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "initContainers": { "$ref": "#/definitions/containerList" },
    "sidecars": { "$ref": "#/definitions/containerList" },
    "extraObjects": { "type": "array", "items": { "type": ["object", "string"] } }
  }
}
